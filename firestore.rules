rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection health check probe
    match /test/connection {
      allow read: if true;
    }

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwnerEmail() {
      return isSignedIn()
        && request.auth.token.email == "smselimreja77@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedOwnerEmail() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedOwnerEmail();
    }

    function isValidScript(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.dayNumber is number && data.dayNumber >= 0 && data.dayNumber <= 1000
        && data.storyParagraphs is list && data.storyParagraphs.size() <= 50
        && data.userId == request.auth.uid;
    }

    // User Profile - strictly restricted to verified authorized owner
    match /users/{userId} {
      allow get, update: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.email == "smselimreja77@gmail.com";
      allow delete: if false;

      // Personal Teleprompter Scripts
      match /scripts/{scriptId} {
        allow get, delete: if isOwner(userId) && isValidId(scriptId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(scriptId) && isValidScript(request.resource.data);
        allow update: if isOwner(userId) && isValidId(scriptId) && isValidScript(request.resource.data) && request.resource.data.userId == resource.data.userId;
      }

      // Personal Practice Reflections & Win Logs
      match /reflections/{reflectionId} {
        allow get, delete: if isOwner(userId) && isValidId(reflectionId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(reflectionId);
      }
    }

    // Master Curriculum Library - restricted to authorized studio admin (never publicly exposed)
    match /curriculum/{dayId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
