# ==============================================================================
# Cloudflare Pages Headers Configuration
# Security Hardening, Search Engine Optimization & High-Performance Caching
# ==============================================================================

# Global Security Headers across all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Long-term immutable caching for hashed production JavaScript & CSS bundles
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OpenGraph Social Preview Assets (WhatsApp, Telegram, Facebook, Twitter, Discord)
/og-image.jpg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/jpeg

/og-image.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: image/png

/og-image.svg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
  Content-Type: image/svg+xml

# Favicons & Touch Icons
/favicon.svg
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
  Content-Type: image/svg+xml

/favicon-32x32.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
  Content-Type: image/png

/apple-touch-icon.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=604800
  Content-Type: image/png

# Search Engine Crawling & Verification Files
/robots.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/googled9411ac887405dc5.html
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: text/html; charset=utf-8

# LLM Specification & Context Endpoints
/llms.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: text/markdown; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  Content-Type: text/markdown; charset=utf-8
